# Copy to Vercel project Environment Variables (Project > Settings > Environment Variables).
APP_PASSWORD=change-me
APP_SECRET=change-me-to-a-long-random-string

# Vercel Postgres connection vars are injected automatically once you link the db.
# For local `vercel dev`, run `vercel env pull` to download them into .env.local.

# Spotify Web Playback SDK. Create an app at developer.spotify.com/dashboard and
# register these redirect URIs on it (exact match, trailing slash matters):
#   https://<your-domain>/api/spotify
#   http://127.0.0.1:3000/api/spotify     (local `vercel dev`; localhost is rejected)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
